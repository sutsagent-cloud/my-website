---
import SiteLayout from '../layouts/SiteLayout.astro';
import MigratedPage from '../components/MigratedPage.astro';
import migratedPages from '../data/migrated-pages.json';

export function getStaticPaths() {
  return migratedPages.map((page) => ({
    params: { slug: page.file.replace(/\.html$/i, '') },
    props: { page }
  }));
}

const { page } = Astro.props;
---
<SiteLayout title={page.title}>
  <MigratedPage page={page} />
</SiteLayout>
